# Copy to .env (never commit .env). Keys must be at least 16 characters; generate them with
#   openssl rand -base64 24
RAG_ADMIN_KEY=
RAG_USER_KEY=
# Optional: answers come from Claude when set, otherwise extractive (quoted sentences, no model call).
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=change-me
APP_PORT=8080
